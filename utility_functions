# Open a Bash shell in a Docker container.
function dbash() {
    ( docker exec -it $* bash )
}

# Open an sh shell in a Docker container.
function dsh() {
    ( docker exec -it $* sh )
}

# Display logs from a Docker container.
function dlog() {
   ( docker logs $*)
}

# Decode and display the data fields of a Kubernetes Secret.
function see() {
    eval "$* -o json | jq '.data | map_values(@base64d)'"
}

# Repeatedly run a command and report its exit status between runs.
repeat_cmd() {
  local GREEN="\033[1;32m"
  local YELLOW="\033[1;33m"
  local RED="\033[1;31m"
  local RESET="\033[0m"

  while true; do
    "$@"
    local exit_code=$?

    echo -e ""
    echo -e "${YELLOW}─────────────────────────────────────────${RESET}"
    echo -e "${RED}Command exited with code ${exit_code}.${RESET}"
    echo -e "${GREEN}Restarting in 1 second...${RESET}"
    echo -e "${YELLOW}─────────────────────────────────────────${RESET}"

    sleep 1
  done
}


# Find and activate a Python virtualenv in the current directory or a parent.
activate_venv() {
  local venv_name="${1:-.venv}"
  local start_dir="$PWD"
  local dir="$PWD"

  # Abort if any virtualenv is already active
  if [[ -n "$VIRTUAL_ENV" ]]; then
    echo "A venv is already activated at: $VIRTUAL_ENV"
    return 0
  fi

  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/$venv_name" && -f "$dir/$venv_name/bin/activate" ]]; then
      # Found in current directory → activate without confirmation
      if [[ "$dir" == "$start_dir" ]]; then
        source "$dir/$venv_name/bin/activate"
        return 0
      fi

      # Found in parent directory → ask for confirmation (YES is default)
      print -n "Found virtualenv at '$dir/$venv_name'. Activate it? [Y/n] "
      read -r reply
      reply="${reply:-Y}"

      if [[ "$reply" =~ ^[Yy]$ ]]; then
        source "$dir/$venv_name/bin/activate"
        return 0
      else
        echo "Activation cancelled."
        return 1
      fi
    fi

    dir="${dir:h}"
  done

  echo "No virtualenv '$venv_name' found in current or parent directories."
  return 1
}

# Create a Warp tab configuration with panes rooted at the given directory.
create_tab_config() {
  local folder="${1:?Usage: create_tab_config FOLDER_PATH}"
  local abs_folder="${folder:A}"
  local name="${abs_folder:t}"
  local slug="${name:l:gs/ /_/}"
  local out="$HOME/.warp/tab_configs/auto-tab-config-${slug}.toml"

  if [[ ! -d "$abs_folder" ]]; then
    echo "Error: '$abs_folder' is not a directory." >&2
    return 1
  fi

  if [[ -f "$out" ]]; then
    echo "Error: '$out' already exists." >&2
    return 1
  fi

  cat > "$out" <<TOML
name = "Tab for - ${abs_folder/#$HOME/~}"

[[panes]]
id = "root"
split = "horizontal"
children = ["left", "right_stack"]

[[panes]]
id = "left"
type = "terminal"
directory = "${abs_folder}"
is_focused = true

[[panes]]
id = "right_stack"
split = "vertical"
children = ["top_right", "bottom_right"]

[[panes]]
id = "top_right"
type = "terminal"
directory = "${abs_folder}"

[[panes]]
id = "bottom_right"
type = "terminal"
directory = "${abs_folder}"
TOML

  echo "Created: $out"
}

# Generate a random password and format it into groups.
gen_random_password() {
  local total_len=${1:-16}     # default total length
  local group_len=${2:-4}      # default group size
  local use_special=${3:-false}

  local charset='A-Za-z0-9'
  if [[ "$use_special" == "true" ]]; then
    charset='A-Za-z0-9!@#$%^&*'
  fi

  # generate raw password
  local raw
  raw=$(openssl rand -base64 64 | tr -dc "$charset" | head -c "$total_len")

  # format into groups
  echo "$raw" | /usr/bin/sed -E "s/(.{$group_len})/\1-/g; s/-$//"
}

# Query DNS using the resolver configured for the requested domain when available.
sdig() {
  local native=0 args=() a
  for a in "$@"; do
    if [[ "$a" == "--native" ]]; then
      native=1
    else
      args+=("$a")
    fi
  done

  if (( ${#args} == 0 )); then
    print -u2 "usage: sdig [--native] <name|ip> [type] [dig options]"
    return 2
  fi

  set -- "${args[@]}"
  local name=${1%.}; shift

  if (( native )); then
    local qtype="" tok
    for tok in "$@"; do
      case "$tok" in
        -*|+*|@*) continue ;;
        *) qtype=${tok:u} ;;
      esac
    done
    case "$name" in
      *:*|<->.<->.<->.<->) print -r -- "dscacheutil -q host -a ip_address $name"; return 0 ;;
    esac
    case "$qtype" in
      ""|A|AAAA|ANY) print -r -- "dscacheutil -q host -a name $name" ;;
      *)             print -r -- "dns-sd -Q $name $qtype" ;;
    esac
    return 0
  fi

  local ns
  ns=$(scutil --dns | awk -v q="$name" '
    function flush() {
      if (dom != "" && ns != "" && (q == dom || index(q, "." dom) == length(q) - length(dom))) {
        if (length(dom) > bestlen) { bestlen = length(dom); best = ns }
      }
      dom=""; ns=""
    }
    /^resolver #/                   { flush() }
    /^[ \t]*domain[ \t]*:/          { dom=$3 }
    /^[ \t]*nameserver\[0\][ \t]*:/ { ns=$3 }
    END { flush(); if (best != "") print best }
  ')
  if [[ -n "$ns" ]]; then
    dig @"$ns" "$name" "$@"
  else
    dig "$name" "$@"
  fi
}
